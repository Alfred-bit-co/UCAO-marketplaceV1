# Public Supabase browser keys for Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Identity Services (bouton « Se connecter avec Google »).
# Client ID OAuth de type « Application Web » (console Google Cloud > Identifiants).
# C'est le même Client ID que celui déclaré dans Supabase > Authentication > Providers > Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Flask payment micro-service URL.
NEXT_PUBLIC_PAYMENT_API_URL=http://127.0.0.1:5000/api

# Site URL for SEO (sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://ucaomarketplace.vercel.app

# Arcjet security (optional — rate limiting & bot protection on auth).
# Get a key at https://console.arcjet.com
ARCJET_KEY=
