# Public Supabase browser keys for Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Flask payment micro-service URL.
NEXT_PUBLIC_PAYMENT_API_URL=http://127.0.0.1:5000/api

# Site URL for SEO (sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://ucao-marketplace-v1.vercel.app

# Cloudflare Turnstile (anti-robot) : clé de SITE, publique (elle commence par 0x4).
# En local, utilisez la vraie clé (pas une clé de test 1x / 2x / 3x) et gardez localhost dans les Hostnames du widget.
# A mettre aussi dans Vercel : Production, et Preview si vous voulez vous connecter sur les aperçus.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
